{#-
    Every page extends this layout, which extends fineprint.parent_template (the site's
    base). The parent must define "title" and "body"; if yours uses other block names,
    override this file in templates/bundles/FineprintBundle/layout.html.twig.
-#}
{% extends parent_template %}
{% block title %}{{ ('page.' ~ page ~ '.title')|trans({}, domain) }} — {{ site.name }}{% endblock %}
{% block description %}{{ ('page.' ~ page ~ '.description')|trans(params, domain) }}{% endblock %}
{% block body %}
<main class="fineprint fineprint-{{ page|replace({'_': '-'}) }}" lang="{{ locale }}">
    <h1>{% block fineprint_title %}{{ ('page.' ~ page ~ '.title')|trans({}, domain) }}{% endblock %}</h1>
    {% block fineprint_content %}{% endblock %}
    {% block fineprint_footer %}
        {% if fineprint.pages[page].last_updated %}
            <p class="fineprint-updated">{{ 'common.updated'|trans({'%date%': fineprint.pages[page].last_updated}, 'fineprint') }}</p>
        {% endif %}
    {% endblock %}
</main>
{% endblock %}
