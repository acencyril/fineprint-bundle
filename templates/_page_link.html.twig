{#- A link to another Fineprint page, or its plain name when that page is disabled. -#}
{%- set url = fineprint_url(target, locale) -%}
{%- if url %}<a href="{{ url }}">{{ (target ~ '.link_inline')|trans({}, 'fineprint') }}</a>{% else %}{{ (target ~ '.link_inline')|trans({}, 'fineprint') }}{% endif -%}
