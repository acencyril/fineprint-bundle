{% extends '@Fineprint/layout.html.twig' %}
{% trans_default_domain 'fineprint' %}
{% set pv = fineprint.privacy %}
{% set contact = pv.contact_email ?: publisher.email %}
{% set processors = pv.processors %}
{% if pv.host_is_processor %}
    {% set processors = {'host': {name: host.name, role: 'hosting', country: null, outside_eu: false, description: null, safeguards: null, address: host.address}}|merge(processors) %}
{% endif %}
{% block fineprint_content %}
{% block fineprint_intro %}
<p>{{ 'privacy.intro'|trans({'%site%': site.name}) }}</p>
{% endblock %}

{% block fineprint_controller %}
<section class="fineprint-section">
    <h2>{{ 'privacy.controller.heading'|trans }}</h2>
    <p>{{ pv.controller ?: publisher.legal_name }}, {{ publisher.address }}<br>
        {{ 'privacy.controller.contact'|trans }} <a href="mailto:{{ contact }}">{{ contact }}</a>
        {% if pv.dpo_email %}<br>{{ 'privacy.controller.dpo'|trans }} <a href="mailto:{{ pv.dpo_email }}">{{ pv.dpo_email }}</a>{% endif %}</p>
</section>
{% endblock %}

{% block fineprint_activities %}
<section class="fineprint-section">
    <h2>{{ 'privacy.activities.heading'|trans }}</h2>
    {% for a in pv.activities %}
        <h3>{{ a.purpose|fineprint_text(locale) }}</h3>
        <dl class="fineprint-activity">
            {% if a.data %}<dt>{{ 'privacy.activities.data'|trans }}</dt><dd>{{ a.data|fineprint_text(locale) }}</dd>{% endif %}
            <dt>{{ 'privacy.activities.basis'|trans }}</dt><dd>{{ ('privacy.basis.' ~ a.legal_basis)|trans }}</dd>
            {% if a.legitimate_interest %}<dt>{{ 'privacy.activities.interest'|trans }}</dt><dd>{{ a.legitimate_interest|fineprint_text(locale) }}</dd>{% endif %}
            <dt>{{ 'privacy.activities.retention'|trans }}</dt><dd>{{ a.retention|fineprint_text(locale) }}</dd>
            {% if a.processors %}<dt>{{ 'privacy.activities.processors'|trans }}</dt><dd>{% for id in a.processors %}{{ processors[id].name }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>{% endif %}
        </dl>
    {% endfor %}
</section>
{% endblock %}

{% block fineprint_processors %}
{% if processors is not empty %}
<section class="fineprint-section">
    <h2>{{ 'privacy.processors.heading'|trans }}</h2>
    <p>{{ 'privacy.processors.intro'|trans }}</p>
    <ul>
    {% for id, pr in processors %}
        <li><strong>{{ pr.name }}</strong>{% if pr.country %} ({{ pr.country }}){% endif %} — {{ ('privacy.role.' ~ pr.role)|trans }}{% if pr.description %}. {{ pr.description|fineprint_text(locale) }}{% endif %}
            {% if pr.outside_eu %}<br>{{ 'privacy.processors.transfer'|trans }} {{ pr.safeguards|fineprint_text(locale) }}{% endif %}</li>
    {% endfor %}
    </ul>
</section>
{% endif %}
{% endblock %}

{% block fineprint_rights %}
<section class="fineprint-section">
    <h2>{{ 'privacy.rights.heading'|trans }}</h2>
    <p>{{ 'privacy.rights.body'|trans }}</p>
    <p>{{ 'privacy.rights.exercise'|trans }} <a href="mailto:{{ contact }}">{{ contact }}</a>. {{ 'privacy.rights.delay'|trans }}</p>
</section>
{% endblock %}

{% block fineprint_complaint %}
<section class="fineprint-section">
    <h2>{{ 'privacy.complaint.heading'|trans }}</h2>
    <p>{{ 'privacy.complaint.body'|trans }} <a href="https://www.cnil.fr" rel="noopener">www.cnil.fr</a>.</p>
</section>
{% endblock %}

{% block fineprint_cookies_link %}
{% if fineprint_url('cookies', locale) %}
<section class="fineprint-section">
    <h2>{{ 'privacy.cookies.heading'|trans }}</h2>
    <p>{{ 'privacy.cookies.body'|trans }} {{ include('@Fineprint/_page_link.html.twig', {target: 'cookies'}) }}.</p>
</section>
{% endif %}
{% endblock %}
{% endblock %}
