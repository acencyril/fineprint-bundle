{
    "name": "acencyril/fineprint-bundle",
    "type": "symfony-bundle",
    "description": "Legal pages for Symfony sites, assembled from jurisdiction packs (France, EU) and your activities: legal notice, terms of sale, privacy policy, cookies, in French and English.",
    "keywords": [
        "symfony",
        "legal",
        "gdpr",
        "rgpd",
        "mentions-legales",
        "cgv",
        "privacy-policy",
        "cookies",
        "eu"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cyril",
            "homepage": "https://github.com/acencyril"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Acencyril\\FineprintBundle\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Acencyril\\FineprintBundle\\Tests\\": "tests/"
        }
    }
}
